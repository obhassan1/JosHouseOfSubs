PORT=3000
DATABASE_URL=mongodb+srv://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_CLUSTER.mongodb.net/jos_house_of_subs

# Comma-separated frontend URLs allowed to call this API. Do not add a trailing slash.
CLIENT_ORIGINS=http://localhost:4200,https://joshouseofsubs-web.onrender.com,https://joshouseofsubs.com,https://www.joshouseofsubs.com

# Admin credentials. Generate ADMIN_PASSWORD_HASH with:
# npm run hash-password -- "your-long-private-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-generated-bcrypt-hash

# Generate a long random value (at least 32 characters) and keep it private.
JWT_SECRET=replace-with-a-long-random-secret
